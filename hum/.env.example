# Hum — AI director (server-side only; never prefix these with VITE_)
# Copy to .env.local for `npm run dev`, or set them in your Vercel project settings.

# API key for Claude (needed on a deployed site). In `npm run dev` you can leave it empty: the
# director then runs through the `claude` CLI on your Claude subscription (if it's installed and signed in).
ANTHROPIC_API_KEY=

# Dev only: cli = always use your subscription via the claude CLI, api = always use the key.
# HUM_DIRECTOR=
# Model for the CLI backend: sonnet | opus | fable | a full model id. Default sonnet.
# HUM_CLI_MODEL=sonnet

# Model id. Default: claude-sonnet-5-5
# HUM_MODEL=claude-sonnet-5-5

# Requests per IP per hour (in-memory sliding window). Default 20. 0 disables the limit.
# HUM_RATE_LIMIT=20

# Optional shared code; requests must send a matching `accessCode`. Leave empty for open access.
# HUM_ACCESS_CODE=

# Optional effort override: low | medium | high | xhigh | max
# (default: low for presets, medium for shaders)
# HUM_EFFORT=

# Optional request timeout to Claude in ms. Default 120000.
# HUM_TIMEOUT_MS=120000

# Optional: comma-separated origins allowed to call the Vercel function cross-origin ("*" for any).
# Not needed when the app and /api are served from the same site.
# HUM_ALLOWED_ORIGIN=https://example.com

# Optional API base URL override (proxies, gateways).
# ANTHROPIC_BASE_URL=https://api.anthropic.com
